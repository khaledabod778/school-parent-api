# ============================================
# Database (نفس قاعدة بيانات cloud-api)
# ============================================
# الخيار الأفضل عند نشر الخدمة في نفس مشروع Railway:
DATABASE_URL=postgresql://postgres:WZfheTGxUUAuXmAyptkTkgnFcaaRnXCr@postgres.railway.internal:5432/railway

# أو استخدام الـ Proxy العام (إذا كنت خارج Railway):
# DATABASE_URL=postgresql://postgres:PASSWORD@tokaido.proxy.rlwy.net:35324/railway?sslmode=require

# ============================================
# JWT
# ============================================
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================
# CORS
# ============================================
CORS_ORIGINS=*

# ============================================
# FCM (اختياري — ضع true لتفعيل الإشعارات الفورية)
# ============================================
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=/app/firebase-credentials.json

# ============================================
# App
# ============================================
DEBUG=false
APP_NAME=School Parent API
APP_VERSION=1.0.0